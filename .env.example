######################################################################
#                  AI Chat Assistant - Example .env                  #
#          Copy this file to .env and fill in your secrets           #
######################################################################

##############################
#      DATABASE CONFIG       #
##############################

# Development MongoDB URI (user:pass@host/db)
MONGODB_URI_DEV=mongodb+srv://<user>:<password>@<host>/<dev_db>

# Production MongoDB URI (user:pass@host/db)
MONGODB_URI_PROD=mongodb+srv://<user>:<password>@<host>/<prod_db>

# Test MongoDB URI (used for test scripts)
MONGODB_URI_TEST=mongodb+srv://<user>:<password>@<host>/<test_db>

##############################
#       AUTH SETTINGS        #
##############################

# JWT (token signing) secret key (set to a strong random value in prod!)
JWT_SECRET=your_jwt_secret_here

# JWT token expiry; format examples: 1d, 12h, 3600s
JWT_EXPIRY=1d

# Bcrypt salt rounds (recommended: 10-12 for production, 10 for dev)
BCRYPT_SALT_ROUNDS=10

##############################
#     OPENAI API SETTINGS    #
##############################

# OpenAI API key (get from platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI API base URL (leave default for OpenAI, or set to Azure/proxy endpoint)
OPENAI_API_BASE_URL=https://api.openai.com/v1

##############################
#     SERVER CONFIGURATION   #
##############################

# Express HTTP Server Port (default: 3000)
SERVER_PORT=3000

# Socket.io Server Port (default: 4000)
SOCKET_IO_PORT=4000

##############################
#     RATE LIMITING CONFIG   #
##############################

# API rate limit time window (in milliseconds), e.g., 60000 = 1 min
RATE_LIMIT_WINDOW_MS=60000

# Max requests allowed per IP in window
RATE_LIMIT_MAX=60

##############################
#     CORS CONFIGURATION     #
##############################

# Allowed CORS origins (comma-separated for multiple). 
# Examples: http://localhost:3000, https://yourdomain.com
CORS_ORIGIN=http://localhost:3000

##############################
#    FRONTEND ENV VARS       #
##############################

# Webpack/React: public URL base (keep as / unless deploying to subfolder)
PUBLIC_URL=/

# Frontend: base URL for backend HTTP API (e.g., http://localhost:3000 or prod API URL)
REACT_APP_API_URL=http://localhost:3000

# Frontend: base URL (ws[s]://) for Socket.io server (e.g., ws://localhost:4000)
REACT_APP_SOCKET_URL=ws://localhost:4000

######################################################################
#      Add any custom variables needed for your own deployment!      #
#      Never commit your actual secret values to version control.    #
######################################################################